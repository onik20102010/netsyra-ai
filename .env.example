# Copy this file to .env.local and fill in your real values.
# NEVER commit .env.local or any live API keys/secrets.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# AI provider API keys (server-side only)
OPENROUTER_API_KEY=your-openrouter-key
GEMINI_API_KEY=your-gemini-key
GROQ_API_KEY=your-groq-key
DEEPSEEK_API_KEY=your-deepseek-key
CEREBRAS_API_KEY=your-cerebras-key
MANUS_API_KEY=your-manus-key
GROQ_API_KEY_2=your-groq-key-2
GROQ_API_KEY_3=your-groq-key-3
GROQ_API_KEY_4=your-groq-key-4

# Search / tools
FIRECRAWL_API_KEY=your-firecrawl-key
TAVILY_API_KEY=your-tavily-key
GOOGLE_CSE_KEY=your-google-cse-key
GOOGLE_CSE_ID=your-google-cse-id
NEWSAPI_API_KEY=your-newsapi-key
OPENWEATHER_API_KEY=your-openweather-key
TIMEZONEDB_API_KEY=your-timezonedb-key

# Sentry (public DSN is safe to include)
NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn

# Admin email
ADMIN_EMAIL=your-admin-email@example.com
NEXT_PUBLIC_ADMIN_EMAIL=your-admin-email@example.com

# Public app URL
NEXT_PUBLIC_APP_URL=https://www.netsyraai.com

# Local agent (server-side only)
AGENT_TOKEN= # optional: set a fixed token for the local agent; otherwise a random one is generated
AGENT_PORT=3001
AGENT_HOST=127.0.0.1
AGENT_ALLOWED_ORIGINS=https://www.netsyraai.com,http://localhost:3000,http://localhost:3001
# AGENT_TLS_CERT=localhost.pem
# AGENT_TLS_KEY=localhost-key.pem

# API auth toggles
# Set to false to allow unauthenticated local dev access to the IDE runtime / agent APIs.
REQUIRE_AUTH=true
# Set to true to disable the server-side workspace fallback and force the local agent.
DISABLE_SERVER_IDE=false
